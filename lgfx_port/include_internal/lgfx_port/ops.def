// lgfx_port/include_internal/lgfx_port/ops.def
//
// Canonical operation list + protocol metadata.
//
// This file is the source of truth for:
//
// - numeric opcode order
// - native operation enum values
// - native handler declarations
// - native dispatch metadata
// - Elixir generated operation schema
// - generated protocol reference tables
//
// Included multiple times with different X(...) definitions.
// No include guards.
//
// Maintainer rule:
//
// - Add, remove, or reorder protocol operations here first.
// - Do not hand-maintain duplicate opcode, arity, flag, target, state,
//   capability, or batch metadata elsewhere.
// - After changing this file, regenerate/check derived files.
//
// First 9 fields are protocol-facing and must remain stable in meaning.
// Final 4 fields are internal execution metadata for the binary batch path.
//
// X(op_name, handler_fn, atom_str,
//   min_arity, max_arity, allowed_flags_mask, target_policy, state_policy, feature_cap_bit,
//   batchable, needs_owned_payload, sync_only, batch_boundary_sensitive)

//
// Control
//
X(ping, lgfx_handle_ping, ATOM_STR("\x04", "ping"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_ANY, 0, 0, 0, 1, 0)
X(getCaps, lgfx_handle_getCaps, ATOM_STR("\x08", "get_caps"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_ANY, 0, 0, 0, 1, 0)
X(getLastError, lgfx_handle_getLastError, ATOM_STR("\x0E", "get_last_error"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_ANY, LGFX_CAP_LAST_ERROR, 0, 0, 1, 0)
X(width, lgfx_handle_width, ATOM_STR("\x05", "width"), 5, 5, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(height, lgfx_handle_height, ATOM_STR("\x06", "height"), 5, 5, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)

//
// Setup
//
X(init, lgfx_handle_init, ATOM_STR("\x04", "init"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_ANY, 0, 0, 0, 1, 0)
X(close, lgfx_handle_close, ATOM_STR("\x05", "close"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_ANY, 0, 0, 0, 1, 0)
X(startWrite, lgfx_handle_startWrite, ATOM_STR("\x0B", "start_write"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(endWrite, lgfx_handle_endWrite, ATOM_STR("\x09", "end_write"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(setRotation, lgfx_handle_setRotation, ATOM_STR("\x0C", "set_rotation"), 6, 6, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(setBrightness, lgfx_handle_setBrightness, ATOM_STR("\x0E", "set_brightness"), 6, 6, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(setColorDepth, lgfx_handle_setColorDepth, ATOM_STR("\x0F", "set_color_depth"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(setSwapBytes, lgfx_handle_setSwapBytes, ATOM_STR("\x0E", "set_swap_bytes"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(display, lgfx_handle_display, ATOM_STR("\x07", "display"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 1)

//
// Primitives
//
X(fillScreen, lgfx_handle_fillScreen, ATOM_STR("\x0B", "fill_screen"), 6, 6, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(clear, lgfx_handle_clear, ATOM_STR("\x05", "clear"), 6, 6, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawPixel, lgfx_handle_drawPixel, ATOM_STR("\x0A", "draw_pixel"), 8, 8, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawFastVLine, lgfx_handle_drawFastVLine, ATOM_STR("\x0F", "draw_fast_vline"), 9, 9, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawFastHLine, lgfx_handle_drawFastHLine, ATOM_STR("\x0F", "draw_fast_hline"), 9, 9, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawLine, lgfx_handle_drawLine, ATOM_STR("\x09", "draw_line"), 10, 10, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawRect, lgfx_handle_drawRect, ATOM_STR("\x09", "draw_rect"), 10, 10, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(fillRect, lgfx_handle_fillRect, ATOM_STR("\x09", "fill_rect"), 10, 10, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawRoundRect, lgfx_handle_drawRoundRect, ATOM_STR("\x0F", "draw_round_rect"), 11, 11, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(fillRoundRect, lgfx_handle_fillRoundRect, ATOM_STR("\x0F", "fill_round_rect"), 11, 11, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawCircle, lgfx_handle_drawCircle, ATOM_STR("\x0B", "draw_circle"), 9, 9, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(fillCircle, lgfx_handle_fillCircle, ATOM_STR("\x0B", "fill_circle"), 9, 9, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawEllipse, lgfx_handle_drawEllipse, ATOM_STR("\x0C", "draw_ellipse"), 10, 10, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(fillEllipse, lgfx_handle_fillEllipse, ATOM_STR("\x0C", "fill_ellipse"), 10, 10, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawArc, lgfx_handle_drawArc, ATOM_STR("\x08", "draw_arc"), 12, 12, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(fillArc, lgfx_handle_fillArc, ATOM_STR("\x08", "fill_arc"), 12, 12, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawBezier, lgfx_handle_drawBezier, ATOM_STR("\x0B", "draw_bezier"), 12, 14, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(drawTriangle, lgfx_handle_drawTriangle, ATOM_STR("\x0D", "draw_triangle"), 12, 12, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(fillTriangle, lgfx_handle_fillTriangle, ATOM_STR("\x0D", "fill_triangle"), 12, 12, LGFX_F_COLOR_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)

//
// Text
//
X(setTextSize, lgfx_handle_setTextSize, ATOM_STR("\x0D", "set_text_size"), 6, 7, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(setTextDatum, lgfx_handle_setTextDatum, ATOM_STR("\x0E", "set_text_datum"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(setTextWrap, lgfx_handle_setTextWrap, ATOM_STR("\x0D", "set_text_wrap"), 6, 7, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(setTextFontPreset, lgfx_handle_setTextFontPreset, ATOM_STR("\x14", "set_text_font_preset"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(setTextColor, lgfx_handle_setTextColor, ATOM_STR("\x0E", "set_text_color"), 6, 7, (LGFX_F_TEXT_HAS_BG | LGFX_F_TEXT_FG_INDEX | LGFX_F_TEXT_BG_INDEX), LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(setCursor, lgfx_handle_setCursor, ATOM_STR("\x0A", "set_cursor"), 7, 7, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(getCursor, lgfx_handle_getCursor, ATOM_STR("\x0A", "get_cursor"), 5, 5, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 0, 1, 0)
X(drawString, lgfx_handle_drawString, ATOM_STR("\x0B", "draw_string"), 8, 8, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 1, 0, 0)
X(print, lgfx_handle_print, ATOM_STR("\x05", "print"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 1, 0, 0)
X(println, lgfx_handle_println, ATOM_STR("\x07", "println"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 1, 0, 0)

//
// Images
//
X(drawJpg, lgfx_handle_drawJpg, ATOM_STR("\x08", "draw_jpg"), 8, 14, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 0, 1, 1, 0)
X(pushImage, lgfx_handle_pushImage, ATOM_STR("\x0A", "push_image"), 11, 11, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_PUSHIMAGE, 0, 1, 1, 0)

//
// Clipping
//
X(setClipRect, lgfx_handle_setClipRect, ATOM_STR("\x0D", "set_clip_rect"), 9, 9, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)
X(clearClipRect, lgfx_handle_clearClipRect, ATOM_STR("\x0F", "clear_clip_rect"), 5, 5, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, 0, 1, 0, 0, 0)

//
// Sprites
//
X(createSprite, lgfx_handle_createSprite, ATOM_STR("\x0D", "create_sprite"), 7, 8, 0, LGFX_OP_TARGET_SPRITE_ONLY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_SPRITE, 0, 0, 1, 0)
X(deleteSprite, lgfx_handle_deleteSprite, ATOM_STR("\x0D", "delete_sprite"), 5, 5, 0, LGFX_OP_TARGET_SPRITE_ONLY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_SPRITE, 0, 0, 1, 0)
X(createPalette, lgfx_handle_createPalette, ATOM_STR("\x0E", "create_palette"), 5, 5, 0, LGFX_OP_TARGET_SPRITE_ONLY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_PALETTE, 0, 0, 1, 0)
X(setPaletteColor, lgfx_handle_setPaletteColor, ATOM_STR("\x11", "set_palette_color"), 7, 7, 0, LGFX_OP_TARGET_SPRITE_ONLY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_PALETTE, 1, 0, 0, 0)
X(setPivot, lgfx_handle_setPivot, ATOM_STR("\x09", "set_pivot"), 7, 7, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_SPRITE, 1, 0, 0, 0)

// Header target is the source sprite; payload begins with destination target.
X(pushSprite, lgfx_handle_pushSprite, ATOM_STR("\x0B", "push_sprite"), 8, 9, LGFX_F_TRANSPARENT_INDEX, LGFX_OP_TARGET_SPRITE_ONLY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_SPRITE, 1, 0, 0, 0)

// Header target is the source sprite; payload begins with destination target.
X(pushRotateZoom, lgfx_handle_pushRotateZoom, ATOM_STR("\x10", "push_rotate_zoom"), 11, 12, LGFX_F_TRANSPARENT_INDEX, LGFX_OP_TARGET_SPRITE_ONLY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_SPRITE, 1, 0, 0, 0)

//
// Touch
//
// getTouch/getTouchRaw reply with {ok, none} or {ok, {X, Y, Size}}.
X(getTouch, lgfx_handle_getTouch, ATOM_STR("\x09", "get_touch"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_TOUCH, 0, 0, 1, 0)
X(getTouchRaw, lgfx_handle_getTouchRaw, ATOM_STR("\x0D", "get_touch_raw"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_TOUCH, 0, 0, 1, 0)
X(setTouchCalibrate, lgfx_handle_setTouchCalibrate, ATOM_STR("\x13", "set_touch_calibrate"), 13, 13, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_TOUCH, 0, 0, 1, 0)
X(calibrateTouch, lgfx_handle_calibrateTouch, ATOM_STR("\x0F", "calibrate_touch"), 5, 5, 0, LGFX_OP_TARGET_BAD_TARGET, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_TOUCH, 0, 0, 1, 0)

//
// Binary hot-path ops
//
// Header target is the destination target; payload contains source sprite instances.
X(pushRotateZoomList, lgfx_handle_pushRotateZoomList, ATOM_STR("\x15", "push_rotate_zoom_list"), 6, 6, LGFX_F_TRANSPARENT_INDEX, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_SPRITE, 1, 0, 0, 0)
X(submitBinaryBatch, lgfx_handle_submitBinaryBatch, ATOM_STR("\x13", "submit_binary_batch"), 6, 6, 0, LGFX_OP_TARGET_ANY, LGFX_OP_STATE_REQUIRES_INIT, LGFX_CAP_BATCH, 0, 0, 1, 0)
